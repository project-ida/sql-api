# Paste inside the existing HTTPS <VirtualHost *:443>, or Include this file
# from inside that virtual host, after installing PHP/pgsql.
# Adjust the checkout path. Keep the checkout outside the existing DocumentRoot
# and expose ONLY server/public. The Alias maps /sql-api/ to this directory;
# other URL paths continue to use the site's existing configuration.
Alias "/sql-api/" "/var/www/sql-api/server/public/"

<Directory "/var/www/sql-api/server/public">
    Require all granted
    Options -Indexes
    AllowOverride None
    # Forward HTTP Basic credentials to PHP, including CGI/PHP-FPM deployments.
    CGIPassAuth On
</Directory>

# Endpoint: https://your-server.example/sql-api/query.php
# Keep the existing PHP handler and TLS configuration for this virtual host.
# If the PHP handler is scoped to another directory, apply it to this one too.
# For long queries, align Apache/FPM execution timeouts with client timeouts.
